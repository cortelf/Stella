<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>CortelF</Authors>
    <Copyright>Copyright (c) CortelF 2025</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageTags>telegram,telegram-bot</PackageTags>
    <PackageProjectUrl>https://github.com/cortelf/Stella</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cortelf/Stella</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Title>Stella - The framework for Telegram Bot development</Title>
    <Description>Convenient and pleasant framework for developing Telegram bots on .NET</Description>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
	  <PackageReference Include="Telegram.Bot" Version="22.5.1" />
  </ItemGroup>

</Project>
