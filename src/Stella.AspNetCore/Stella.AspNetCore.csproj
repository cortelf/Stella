<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
        <OutputType>Library</OutputType>
		<Authors>CortelF</Authors>
		<Copyright>Copyright (c) CortelF 2025</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageTags>telegram,telegram-bot</PackageTags>
		<PackageProjectUrl>https://github.com/cortelf/Stella</PackageProjectUrl>
		<RepositoryUrl>https://github.com/cortelf/Stella</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Title>Easy-to-use Library for Integrating Stella with ASP.NET Core</Title>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\..\LICENSE">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Stella\Stella.csproj" />
    </ItemGroup>

</Project>
